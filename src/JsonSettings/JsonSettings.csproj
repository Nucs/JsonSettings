<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net48;net6.0;net8.0;net10.0</TargetFrameworks>
	<Summary>Easiest way you'll ever write settings for your app. Cross-platform, modular and still a one-liner.
Encrypt, Encode and have full control over hardcoded / dynamic settings.</Summary>
    <Description>Easiest way you'll ever write settings for your app. This library is built to be modular and one-liner exploiting the powerful serialization capabilities of Json.NET out of the box without any mapping necessary to serialize nested custom objects, dictionaries and lists.</Description>
    <RootNamespace>Nucs.JsonSettings</RootNamespace>
    <PackageId>Nucs.JsonSettings</PackageId>
    <!-- Ship as Nucs.JsonSettings.dll so the assembly identity equals the PackageId and the root
         namespace. Set explicitly because the .csproj/folder keep the short JsonSettings name (source
         layout only); without this the assembly would default to that short name and drift from the
         package and namespace. -->
    <AssemblyName>Nucs.JsonSettings</AssemblyName>
    <Title>Nucs.JsonSettings</Title>
    <!-- Held at 9.0 on purpose, below the repo-wide 12.0 in Directory.Build.props. This is
         the netstandard2.0-facing assembly, and keeping the syntax within C# 9 keeps it
         buildable by consumers who vendor the sources into an older toolchain. Raise it
         only with a reason. -->
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- GeneratePackageOnBuild is deliberately absent. On a multi-targeted project it hooks
         Pack into the build, and the hooked Pack runs before every inner target framework has
         written its assembly, so `dotnet pack` from a clean tree fails with NU5026 reporting
         that a target framework's assembly "was not found on disk". Packaging is the release
         pipeline's job and it packs explicitly; a developer build has no reason to emit
         .nupkg files into bin/ as a side effect. -->
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Autosave\**" />
    <EmbeddedResource Remove="Autosave\**" />
    <None Remove="Autosave\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Minimum 13.0.3, no upper bound: [13.0.3, ). A bare Version="13.0.3" already MEANS
         ">= 13.0.3" to NuGet - a simple version is a floor, not a pin - and both spellings
         pack to the identical `Newtonsoft.Json (>= 13.0.3)` dependency. The interval form is
         used only so the csproj states that intent instead of reading like an exact pin.
         No maximum on purpose: a consumer already resolving a newer Json.NET (13.0.4, a
         future 13.x, or a 14.x once one exists) keeps it rather than being forced back, and
         13.0.3 is the floor because the depth backstop (SerializationSettings.MaxDepth = 128,
         see the release notes) assumes Newtonsoft 13's behaviour. This project's own restore
         still takes the lowest match, 13.0.3, so nothing here is built against an untested
         higher version. -->
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.3, )" />
  </ItemGroup>

  <!-- Friend assemblies. A signed assembly may only befriend an assembly it names by public
       key (a plain [assembly: InternalsVisibleTo("name")] attribute is a hard CS1726 here).
       Declared as items rather than as attributes with a 320-character key literal pasted into
       each file: the SDK appends `, PublicKey=$(PublicKey)` from Directory.Build.props, so the
       key is written once for the repository and cannot drift between the two projects that
       grant friendship.

       Both targets are signed with that same key, which is what makes the reference resolve;
       StrongNameTests proves it resolves rather than assuming it. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JsonSettings.Tests" />
    <!-- The Autosave assembly ships as Nucs.JsonSettings.Autosave (see its <AssemblyName>), so the
         friend reference names it by that identity, not by the short JsonSettings.Autosave csproj name. -->
    <InternalsVisibleTo Include="Nucs.JsonSettings.Autosave" />
  </ItemGroup>

</Project>
