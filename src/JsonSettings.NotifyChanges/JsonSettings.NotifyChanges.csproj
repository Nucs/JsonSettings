<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Summary>Raise INotifyPropertyChanged / INotifyPropertyChanging from your settings setters for data binding (WPF, WinForms, Avalonia, WinUI, MAUI, Uno) using compile-time IL weaving. Native AOT compatible. Mark a class [NotifyChanges] (with a notifying base or convention raiser) or [NotifyChangesMixin] (no base needed) and every setter notifies - no hand-written OnPropertyChanged. Composes with Nucs.JsonSettings.Autosave.</Summary>
    <Description>An extension to JsonSettings that turns a settings class into an observable, bindable object. [NotifyChanges] and [NotifyChangesMixin] rewrite your property setters at compile time to raise INotifyPropertyChanged - no proxy, no virtual requirement, nothing generated at runtime, so it works under Native AOT. Optional INotifyPropertyChanging, dependent-property notification via [NotifyChangesFor], and opt-in SynchronizationContext marshalling for off-thread writes. Framework-neutral: depends only on System.ComponentModel, not on WPF.</Description>
    <TargetFrameworks>netstandard2.0;net48;net6.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Nucs.JsonSettings.NotifyChanges</RootNamespace>
    <PackageId>Nucs.JsonSettings.NotifyChanges</PackageId>
    <!-- Ship as Nucs.JsonSettings.NotifyChanges.dll so assembly identity = PackageId = namespace; the
         short .csproj/folder name is source layout only. See the note in JsonSettings.csproj. -->
    <AssemblyName>Nucs.JsonSettings.NotifyChanges</AssemblyName>
    <Title>Nucs.JsonSettings.NotifyChanges</Title>
    <!-- GeneratePackageOnBuild is deliberately absent; see the note in JsonSettings.csproj.
         In short: on a multi-targeted project it makes `dotnet pack` from a clean tree fail
         with NU5026, and packaging is the release pipeline's job. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Minimum 13.0.3, no upper bound - same [13.0.3, ) range and rationale as
         JsonSettings.csproj. Not used by the notification runtime directly, but its XML docs
         cref Newtonsoft's JsonIgnoreAttribute, and keeping the reference explicit matches the
         Autosave package and guarantees the doc reference resolves. -->
    <PackageReference Include="Newtonsoft.Json" Version="[13.0.3, )" />

    <!-- Same weaver, same flow rules as Nucs.JsonSettings.Autosave. The weaving has to happen
         in the assembly that DECLARES the settings class, which is the consumer's, not ours, so
         this is NOT marked PrivateAssets="all": AspectInjector's buildTransitive/ targets must
         reach a project that references this package (directly or indirectly), otherwise the
         consumer gets a [NotifyChanges] attribute that compiles and never does anything. -->
    <PackageReference Include="AspectInjector" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JsonSettings\JsonSettings.csproj" />
  </ItemGroup>

  <!-- Ship the re-signing targets to consumers. build/ covers a direct reference;
       buildTransitive/ covers a consumer who picks this package up through another package.
       Same file in both, matching how AspectInjector ships its own. The target/property names
       are prefixed NucsNotifyChanges (not NucsAutosave) so a consumer referencing BOTH this and
       Nucs.JsonSettings.Autosave does not get two MSBuild targets of the same name. -->
  <ItemGroup>
    <None Include="build\Nucs.JsonSettings.NotifyChanges.targets" Pack="true" PackagePath="build\" Visible="false" />
    <None Include="build\Nucs.JsonSettings.NotifyChanges.targets" Pack="true" PackagePath="buildTransitive\" Visible="false" />
  </ItemGroup>

  <!-- See the note on the same item group in JsonSettings.csproj: declared as an item so the
       public key comes from $(PublicKey) in Directory.Build.props rather than being pasted
       here as a literal. -->
  <ItemGroup>
    <InternalsVisibleTo Include="JsonSettings.Tests" />
  </ItemGroup>

</Project>
