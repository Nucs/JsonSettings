<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Runnable frameworks only. netstandard2.0 is not a runtime: VSTest reports
             "No suitable test runtime provider was found for any source in this run" and
             `dotnet test` exits 1 even when every other target passes. -->
        <TargetFrameworks>net48;net6.0;net8.0</TargetFrameworks>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Nucs.JsonSettings.Tests</RootNamespace>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
        <PackageReference Include="MSTest.TestAdapter" Version="3.1.1" />
        <PackageReference Include="MSTest.TestFramework" Version="3.1.1" />
        <PackageReference Include="FluentAssertions" Version="4.19.4" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
        <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\src\JsonSettings.Autosave\JsonSettings.Autosave.csproj" />
      <ProjectReference Include="..\..\src\JsonSettings\JsonSettings.csproj" />
    </ItemGroup>

</Project>
