<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Nucs.JsonSettings</RootNamespace>
    <!-- A demo app, not a shipped artifact. It exists so the library is compiled against
         from a real consumer on every shipped target. -->
    <IsPackable>false</IsPackable>
	<OutputType>Exe</OutputType>
	<UseWindowsForms>true</UseWindowsForms>
	<TargetFrameworks>net6.0-windows;net8.0-windows;net10.0-windows</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\JsonSettings.Autosave\JsonSettings.Autosave.csproj" />
    <ProjectReference Include="..\..\src\JsonSettings\JsonSettings.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Properties" />
  </ItemGroup>

</Project>
